# ---------------------------------------------------------------------------
# apps/api/.env
# ---------------------------------------------------------------------------

# Pooled connection. Used by the running application, which opens many
# short-lived connections. On Neon this is the host containing "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Unpooled connection, used ONLY by migrations. Migrations take advisory locks
# and issue DDL, neither of which survives a transaction pooler. On Neon this is
# the same host WITHOUT "-pooler".
#
# Required in every environment — Prisma errors if it is missing and does not
# fall back to DATABASE_URL. Against a local Postgres with no pooler, set it to
# exactly the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Local only. Hosts inject their own PORT — do not set it in production.
PORT=4000

# "production" when deployed.
NODE_ENV="development"

# Only used for direct (non-proxied) access, e.g. Swagger or curl. The browser
# reaches the API through the web app's rewrite proxy, so this is not what makes
# authentication work.
WEB_ORIGIN="http://localhost:3000"


# ---------------------------------------------------------------------------
# apps/web/.env.local
# ---------------------------------------------------------------------------

# Upstream API address. Server-only — deliberately NOT prefixed NEXT_PUBLIC_,
# so the API's real host is never shipped to the browser. next.config.ts
# rewrites /api/* here. No trailing slash.
API_URL="http://localhost:4000"

# Leave this unset. The client calls its own origin and Next proxies onward,
# which keeps the session cookie first-party so middleware can read it. Setting
# it to the API's public URL reintroduces the cross-domain cookie problem and
# will produce a redirect loop between /login and /tasks in production.
# NEXT_PUBLIC_API_URL=""


# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# These are PLACEHOLDERS. If your host offers to import this file as suggested
# variables, do not accept the values as-is — replace every one with a real
# credential first.
#
# Railway (API):  DATABASE_URL, DIRECT_URL, JWT_SECRET,
#                 NODE_ENV=production, NPM_CONFIG_PRODUCTION=false
# Vercel (web):   API_URL = the Railway public URL, no trailing slash
